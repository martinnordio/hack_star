[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/fighter_list.gd" id="1_list"]
[ext_resource type="PackedScene" path="res://scenes/ui/back_button.tscn" id="2_back"]
[ext_resource type="PackedScene" path="res://scenes/ui/menu_background.tscn" id="3_background"]

[node name="FighterList" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_list")

[node name="Background" parent="." instance=ExtResource("3_background")]
layout_mode = 1

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 16

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Header" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2

[node name="BackButton" parent="Margin/Column/Header" instance=ExtResource("2_back")]
layout_mode = 2

[node name="Title" type="Label" parent="Margin/Column/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HeadingLabel"
text = "Fighters"
horizontal_alignment = 1

[node name="Balance" type="Control" parent="Margin/Column/Header"]
custom_minimum_size = Vector2(180, 0)
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 3

[node name="Grid" type="GridContainer" parent="Margin/Column/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 16
columns = 4
