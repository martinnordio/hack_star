[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/home.gd" id="1_home"]
[ext_resource type="PackedScene" path="res://scenes/ui/fighter_stage.tscn" id="2_stage"]
[ext_resource type="PackedScene" path="res://scenes/ui/prestige_badge.tscn" id="3_badge"]
[ext_resource type="PackedScene" path="res://scenes/ui/menu_background.tscn" id="4_background"]
[ext_resource type="PackedScene" path="res://scenes/ui/icon_chip.tscn" id="5_chip"]

[node name="Home" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_home")

[node name="Background" parent="." instance=ExtResource("4_background")]
layout_mode = 1

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 16

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TopBar" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2

[node name="TrophiesChip" parent="Margin/Column/TopBar" instance=ExtResource("5_chip")]
layout_mode = 2
size_flags_vertical = 4
text = "0"

[node name="Spacer" type="Control" parent="Margin/Column/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="CreditsChip" parent="Margin/Column/TopBar" instance=ExtResource("5_chip")]
layout_mode = 2
size_flags_vertical = 4
icon_name = "coin"
text = "0"

[node name="Title" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 20
alignment = 1

[node name="Hack" type="Label" parent="Margin/Column/Title"]
layout_mode = 2
theme_type_variation = &"LogoHackLabel"
text = "Hack"

[node name="Star" type="Label" parent="Margin/Column/Title"]
layout_mode = 2
theme_type_variation = &"LogoStarLabel"
text = "star"

[node name="Body" type="BoxContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 16

[node name="FighterStage" parent="Margin/Column/Body" instance=ExtResource("2_stage")]
custom_minimum_size = Vector2(240, 160)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Controls" type="VBoxContainer" parent="Margin/Column/Body"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 16
alignment = 2

[node name="NameRow" type="HBoxContainer" parent="Margin/Column/Body/Controls"]
layout_mode = 2
