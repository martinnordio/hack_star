[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/hack_screen.gd" id="1_hack"]
[ext_resource type="PackedScene" path="res://scenes/ui/back_button.tscn" id="2_back"]

[sub_resource type="StyleBoxFlat" id="Dialog_panel"]
content_margin_left = 16.0
content_margin_top = 8.0
content_margin_right = 16.0
content_margin_bottom = 16.0
bg_color = Color(0.16, 0.14, 0.3, 1)

[node name="HackScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_hack")

[node name="Background" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"BackgroundPanel"

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 16

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Header" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2

[node name="BackButton" parent="Margin/Column/Header" instance=ExtResource("2_back")]
layout_mode = 2

[node name="Title" type="Label" parent="Margin/Column/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HeadingLabel"
text = "Hack"
horizontal_alignment = 1

[node name="Balance" type="Control" parent="Margin/Column/Header"]
custom_minimum_size = Vector2(180, 0)
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Content" type="VBoxContainer" parent="Margin/Column/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 20

[node name="CodeRow" type="HBoxContainer" parent="Margin/Column/Scroll/Content"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="CodeEdit" type="LineEdit" parent="Margin/Column/Scroll/Content/CodeRow"]
custom_minimum_size = Vector2(0, 80)
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Type a code"
max_length = 100

[node name="UseButton" type="Button" parent="Margin/Column/Scroll/Content/CodeRow"]
custom_minimum_size = Vector2(260, 80)
layout_mode = 2
text = "Use code"

[node name="ScanButton" type="Button" parent="Margin/Column/Scroll/Content"]
visible = false
custom_minimum_size = Vector2(0, 80)
layout_mode = 2
text = "Scan QR code"

[node name="Message" type="Label" parent="Margin/Column/Scroll/Content"]
custom_minimum_size = Vector2(0, 80)
layout_mode = 2
theme_type_variation = &"SubheadingLabel"
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="ActiveTitle" type="Label" parent="Margin/Column/Scroll/Content"]
layout_mode = 2
text = "Active hacks"
horizontal_alignment = 1

[node name="ActiveList" type="VBoxContainer" parent="Margin/Column/Scroll/Content"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ResetButton" type="Button" parent="Margin/Column/Scroll/Content"]
custom_minimum_size = Vector2(0, 80)
layout_mode = 2
disabled = true
text = "Turn all hacks off"

[node name="QrButton" type="Button" parent="Margin/Column/Scroll/Content"]
custom_minimum_size = Vector2(0, 80)
layout_mode = 2
text = "QR codes"

[node name="ConfirmDialog" type="ConfirmationDialog" parent="."]
theme_override_styles/panel = SubResource("Dialog_panel")
title = "Turn all hacks off?"
ok_button_text = "Turn off"
dialog_text = "Turn all hacks off?"
cancel_button_text = "Cancel"
