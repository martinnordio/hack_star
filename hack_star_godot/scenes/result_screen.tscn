[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/result_screen.gd" id="1_result"]
[ext_resource type="PackedScene" path="res://scenes/ui/fighter_stage.tscn" id="2_stage"]

[node name="Result" type="Control"]
layout_mode = 3
anchors_preset = 15
